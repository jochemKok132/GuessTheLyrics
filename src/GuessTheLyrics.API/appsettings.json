{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GuessTheLyrics;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "GuessTheLyrics",
    "ExpiryMinutes": 10080
  },
  "Lrclib": {
    "BaseUrl": "https://lrclib.net/",
    "UserAgent": "GuessTheLyrics (https://github.com/jochemKok132/GuessTheLyrics)",
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryBaseDelayMilliseconds": 300,
    "MaxRetryAfterSeconds": 3
  },
  "Frontend": {
    "AllowedOrigins": [ "https://localhost:7181", "http://localhost:5181" ]
  }
}
