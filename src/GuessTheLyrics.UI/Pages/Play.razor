@page "/play/{Id:long}"
@using System.Diagnostics
@implements IDisposable
@inject ISongService SongService
@inject IProgressService ProgressService
@inject IMatchClient MatchClient
@inject NavigationManager Navigation

<PageTitle>@(game is null ? "GuessTheLyrics" : $"{game.Puzzle.Title} · {game.Puzzle.Artist}")</PageTitle>

@if (loading)
{
    <div class="spinner" aria-label="Loading lyrics"></div>
}
else if (error is not null || game is null)
{
    <h1 class="page-title" tabindex="-1">Can't play this song</h1>
    <ErrorMessage Error="@(error ?? new UiError("Something went wrong.", ErrorCodes.Unexpected, null))" OnRetry="RetryLoadAsync" />
    <p><a href="">Back to search</a></p>
}
else
{
    var puzzle = game.Puzzle;

    <div class="play-header">
        <div>
            <h1 class="page-title" tabindex="-1">@puzzle.Title</h1>
            <p class="muted">
                @puzzle.Artist@(string.IsNullOrWhiteSpace(puzzle.Album) ? "" : $" · {puzzle.Album}")
                · @puzzle.TotalWords words (@puzzle.UniqueWords different) · @Format.Time(TimeLimit) to play
            </p>
        </div>
        <div class="header-actions">
            @if (loggedIn)
            {
                <button class="btn btn-secondary" @onclick="CreateMatchAsync" disabled="@creatingMatch">
                    @(creatingMatch ? "Creating..." : "Play against others")
                </button>
            }
            <a class="btn btn-secondary" href="">New song</a>
        </div>
    </div>

    <ErrorMessage Error="matchError" />

    <div class="game-bar card">
        <div class="stat">
            <span class="section-label">Words</span>
            <span class="stat-value">@game.FoundWordCount<span class="stat-total"> / @puzzle.TotalWords</span></span>
        </div>
        <div class="stat">
            <span class="section-label">Score</span>
            <span class="stat-value">@game.Percentage%</span>
        </div>
        <TimeLeft Remaining="Remaining" Limit="TimeLimit"
                  Hint="@(state == GameState.Playing && !stopwatch.IsRunning ? "starts when you type" : null)" />

        <div class="guess-wrap">
            <input @ref="guessInput"
                   class="guess-input"
                   @bind="guess"
                   @bind:event="oninput"
                   @bind:after="CheckGuess"
                   @onkeydown="SubmitGuess"
                   disabled="@(state != GameState.Playing)"
                   placeholder="@(state == GameState.Playing ? "Type any word from the song..." : "Game over")"
                   aria-label="Type a word"
                   autocomplete="off"
                   autocapitalize="off"
                   autocorrect="off"
                   spellcheck="false" />
            <div class="guess-status">
                <span class="guess-feedback" aria-live="polite">@game.Feedback</span>
                <span class="save-state" aria-live="polite">@SaveLabel</span>
            </div>
        </div>

        @if (state == GameState.Playing)
        {
            <button class="btn btn-secondary" @onclick="GiveUpAsync" disabled="@(game.FoundWordCount == 0 && Elapsed == TimeSpan.Zero)">Give up</button>
        }
        else
        {
            <button class="btn" @onclick="RestartAsync">Play again</button>
        }
    </div>

    <div class="progress" role="progressbar" aria-valuenow="@game.Percentage" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-fill @(state == GameState.Won ? "complete" : "")" style="width: @(game.Percentage)%"></div>
    </div>

    @if (state == GameState.Won)
    {
        <div class="alert-success">
            You typed every word of "@puzzle.Title" in @Format.Time(Elapsed), with @Format.Time(Remaining) to spare!
        </div>
    }
    else if (state == GameState.TimeUp)
    {
        <div class="alert-warning">
            Time's up! You found @game.FoundWordCount of @puzzle.TotalWords words (@game.Percentage%).
            The words you missed are shown in red.
        </div>
    }
    else if (state == GameState.GaveUp)
    {
        <div class="alert-danger">
            You found @game.FoundWordCount of @puzzle.TotalWords words (@game.Percentage%) in @Format.Time(Elapsed).
            The words you missed are shown in red.
        </div>
    }
    else if (resumed)
    {
        <div class="alert-info">Welcome back: your progress was restored. The countdown continues when you start typing.</div>
    }

    @if (!loggedIn)
    {
        <div class="alert-info">
            <a href="@($"login?returnUrl={Uri.EscapeDataString($"/play/{Id}")}")">Log in</a> or
            <a href="@($"register?returnUrl={Uri.EscapeDataString($"/play/{Id}")}")">sign up</a>
            to save your progress and play against others.
        </div>
    }

    <div class="play-layout">
        <LyricsBoard Game="game" RevealMissed="@(state is GameState.GaveUp or GameState.TimeUp)" />

        <aside class="side-panel card">
            <div class="side-head">
                <span class="section-label">Players on this song</span>
                <span class="muted small">@(songPlayers?.Count ?? 0)</span>
            </div>

            @if (songPlayers is null)
            {
                <p class="muted small">Loading...</p>
            }
            else if (songPlayers.Count == 0)
            {
                <p class="muted small">Nobody has played this song yet@(loggedIn ? ". You'll be the first!" : ".")</p>
            }
            else
            {
                <ol class="player-list">
                    @foreach (var player in songPlayers)
                    {
                        var isMe = string.Equals(player.Username, myName, StringComparison.OrdinalIgnoreCase);
                        <li class="player-row @(isMe ? "me" : "")">
                            <div class="player-row-top">
                                <a class="player-link" href="players/@Uri.EscapeDataString(player.Username)">@player.Username</a>
                                @if (isMe)
                                {
                                    <span class="you">you</span>
                                }
                                <span class="player-score">@player.BestPercentage%</span>
                            </div>
                            <MiniProgress Value="player.BestPercentage" Complete="player.BestTimeSeconds is not null" />
                            <div class="player-row-meta muted">
                                @if (player.BestTimeSeconds is not null)
                                {
                                    <span>✓ @Format.Seconds(player.BestTimeSeconds)</span>
                                }
                                else
                                {
                                    <StatusBadge Status="player.Status" />
                                }
                                <span>@Format.Relative(player.LastPlayedAt)</span>
                            </div>
                        </li>
                    }
                </ol>
            }
        </aside>
    </div>
}

@code {
    private enum GameState { Playing, Won, GaveUp, TimeUp }

    private static readonly TimeSpan AutoSaveInterval = TimeSpan.FromSeconds(10);

    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private GuessGame? game;
    private bool loading = true;
    private UiError? error;
    private long loadedId;

    private string guess = string.Empty;
    private GameState state = GameState.Playing;
    private bool resumed;

    // Time used = time from a saved attempt + time played in this visit. The countdown is the limit minus that.
    private TimeSpan elapsedOffset;
    private readonly Stopwatch stopwatch = new();
    private Timer? clock;
    private ElementReference guessInput;
    private bool focusPending;

    // Accounts and saving
    private bool loggedIn;
    private string? myName;
    private bool dirty;
    private bool saving;
    private bool saveQueued;
    private DateTime lastSave = DateTime.MinValue;
    private string? saveError;
    private bool savedOnce;
    private bool disposed;
    private List<SongPlayerResponse>? songPlayers;

    // Multiplayer
    private bool creatingMatch;
    private UiError? matchError;

    private TimeSpan TimeLimit => TimeSpan.FromSeconds(game?.Puzzle.TimeLimitSeconds ?? 0);

    private TimeSpan Elapsed
    {
        get
        {
            var elapsed = elapsedOffset + stopwatch.Elapsed;
            return elapsed > TimeLimit ? TimeLimit : elapsed;
        }
    }

    private TimeSpan Remaining => TimeLimit - Elapsed;

    private string SaveLabel => !loggedIn ? ""
        : saving ? "Saving..."
        : saveError is not null ? $"Not saved: {saveError} (retrying)"
        : dirty ? "Unsaved changes"
        : savedOnce ? "Progress saved" : "";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            loggedIn = user.Identity?.IsAuthenticated == true;
            myName = user.Identity?.Name;
        }

        if (Id == loadedId)
            return;

        // Switching songs in the same component: save the previous one first.
        if (dirty)
            await SaveAsync();

        await LoadAsync();
    }

    private async Task RetryLoadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        loadedId = Id;
        loading = true;
        error = null;
        game = null;
        songPlayers = null;

        var response = await SongService.GetPuzzleAsync(Id);
        if (response.Succeeded && response.Value is not null)
        {
            game = new GuessGame(response.Value);
            ResetGame();

            if (loggedIn)
                await RestoreProgressAsync();
        }
        else
        {
            error = UiError.From(response);
        }

        loading = false;

        if (game is not null)
            await LoadPlayersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending && game is not null && !loading && state == GameState.Playing)
        {
            focusPending = false;
            try
            {
                await guessInput.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Input not rendered yet; the next render tries again.
                focusPending = true;
            }
        }
    }

    // ---------- Game ----------

    private void CheckGuess()
    {
        if (game is null || state != GameState.Playing)
            return;

        var result = game.Guess(guess);
        guess = result.Input;

        if (result.Typed)
            StartClock();

        if (result.Accepted)
        {
            dirty = true;
            resumed = false;

            if (game.AllFound)
                _ = EndGameAsync(GameState.Won);
        }
    }

    private void SubmitGuess(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            guess += " ";
            CheckGuess();
        }
    }

    private Task GiveUpAsync() => EndGameAsync(GameState.GaveUp);

    private async Task EndGameAsync(GameState endState)
    {
        if (state != GameState.Playing)
            return;

        state = endState;
        guess = string.Empty;
        resumed = false;
        StopClock();
        dirty = true;
        await SaveAsync();
    }

    private async Task RestartAsync()
    {
        ResetGame();
        dirty = true;
        await SaveAsync();
    }

    private void ResetGame()
    {
        StopClock();
        stopwatch.Reset();
        elapsedOffset = TimeSpan.Zero;
        game?.Reset();
        guess = string.Empty;
        state = GameState.Playing;
        resumed = false;
        focusPending = true;
    }

    private void StartClock()
    {
        if (stopwatch.IsRunning)
            return;

        stopwatch.Start();
        clock = new Timer(_ => InvokeAsync(OnTickAsync), null, TimeSpan.FromMilliseconds(250), TimeSpan.FromMilliseconds(250));
    }

    private void StopClock()
    {
        stopwatch.Stop();
        clock?.Dispose();
        clock = null;
    }

    private async Task OnTickAsync()
    {
        if (disposed)
            return;

        if (state == GameState.Playing && Remaining <= TimeSpan.Zero)
        {
            await EndGameAsync(GameState.TimeUp);
        }
        else if (dirty && DateTime.UtcNow - lastSave >= AutoSaveInterval)
        {
            await SaveAsync();
        }

        StateHasChanged();
    }

    // ---------- Saving ----------

    private async Task RestoreProgressAsync()
    {
        var response = await ProgressService.GetMineAsync(Id);
        if (game is null || !response.Succeeded || response.Value is not { } saved)
            return;

        game.Restore(saved.FoundKeys ?? []);
        elapsedOffset = TimeSpan.FromSeconds(saved.ElapsedSeconds);
        state = saved.Status switch
        {
            ProgressStatusDto.Completed => GameState.Won,
            ProgressStatusDto.GaveUp => GameState.GaveUp,
            ProgressStatusDto.TimeUp => GameState.TimeUp,
            _ when Remaining <= TimeSpan.Zero => GameState.TimeUp, // saved before the countdown ran out, never finished
            _ => GameState.Playing
        };
        resumed = state == GameState.Playing && game.Found.Count > 0;
        savedOnce = true;
    }

    private async Task SaveAsync()
    {
        if (!loggedIn || game is null)
            return;

        // One save at a time; a save requested meanwhile runs right after with the latest state.
        if (saving)
        {
            saveQueued = true;
            return;
        }

        saving = true;
        var songId = game.Puzzle.Id;

        do
        {
            saveQueued = false;
            dirty = false;
            lastSave = DateTime.UtcNow;

            var request = new SaveProgressRequest
            {
                FoundKeys = game.Found.ToList(),
                ElapsedSeconds = (int)Math.Round(Elapsed.TotalSeconds),
                Status = state switch
                {
                    GameState.GaveUp => ProgressStatusDto.GaveUp,
                    GameState.TimeUp => ProgressStatusDto.TimeUp,
                    _ => ProgressStatusDto.InProgress
                }
            };

            var response = await ProgressService.SaveAsync(songId, request);

            if (response.Succeeded)
            {
                saveError = null;
                savedOnce = true;
            }
            else
            {
                saveError = response.Message;
                dirty = true;
            }
        }
        while (saveQueued);

        saving = false;

        if (disposed)
            return;

        // Refresh the side panel so your own row (and anyone else's) is current.
        if (saveError is null)
            await LoadPlayersAsync();

        StateHasChanged();
    }

    private async Task LoadPlayersAsync()
    {
        var response = await ProgressService.GetPlayersAsync(Id);
        songPlayers = response.Succeeded ? response.Value ?? [] : [];
    }

    // ---------- Multiplayer ----------

    private async Task CreateMatchAsync()
    {
        creatingMatch = true;
        matchError = null;

        var response = await MatchClient.CreateAsync(Id);

        creatingMatch = false;
        if (response.Succeeded && response.Value is not null)
            Navigation.NavigateTo($"match/{response.Value.Code}");
        else
            matchError = UiError.From(response);
    }

    public void Dispose()
    {
        disposed = true;
        clock?.Dispose();

        // Leaving the page with unsaved words: save them in the background.
        if (dirty && loggedIn && game is not null)
            _ = SaveAsync();
    }
}
