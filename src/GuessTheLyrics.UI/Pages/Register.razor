@page "/register"
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Sign up · GuessTheLyrics</PageTitle>

<div class="auth-card card">
    <h1 class="page-title" tabindex="-1">Create an account</h1>
    <p class="muted">Save your progress on every song and compare scores with other players.</p>

    @if (error is not null)
    {
        <ErrorMessage Error="error" OnRetry="SubmitAsync" />
    }

    <form class="form" @onsubmit="SubmitAsync">
        <label>
            <span class="section-label">Username</span>
            <input @bind="request.Username" @bind:event="oninput" autocomplete="username" autocapitalize="off" maxlength="20" />
            <span class="hint">3-20 characters: letters, digits, - and _. Other players will see this name.</span>
        </label>
        <label>
            <span class="section-label">Password</span>
            <input type="password" @bind="request.Password" @bind:event="oninput" autocomplete="new-password" />
            <span class="hint">At least 8 characters.</span>
        </label>
        <label>
            <span class="section-label">Repeat password</span>
            <input type="password" @bind="repeatPassword" @bind:event="oninput" autocomplete="new-password" />
        </label>
        <button type="submit" class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(request.Username) || string.IsNullOrEmpty(request.Password))">
            @(busy ? "Creating account..." : "Create account")
        </button>
    </form>

    <p class="muted small">Already have an account? <a href="@($"login{ReturnQuery}")">Log in</a></p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private readonly RegisterRequest request = new();
    private string repeatPassword = string.Empty;
    private bool busy;
    private UiError? error;

    private string ReturnQuery => string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private async Task SubmitAsync()
    {
        if (request.Password != repeatPassword)
        {
            error = new UiError("The passwords don't match.", ErrorCodes.Validation, null);
            return;
        }

        busy = true;
        error = null;

        var response = await AccountService.RegisterAsync(request);

        busy = false;
        if (response.Succeeded)
            Navigation.NavigateTo(Login.SafeReturnUrl(ReturnUrl));
        else
            error = UiError.From(response);
    }
}
