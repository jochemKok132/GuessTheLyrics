@page "/login"
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Log in · GuessTheLyrics</PageTitle>

<div class="auth-card card">
    <h1 class="page-title" tabindex="-1">Log in</h1>
    <p class="muted">Welcome back. Your progress is saved to your account.</p>

    @if (error is not null)
    {
        <ErrorMessage Error="error" OnRetry="SubmitAsync" />
    }

    <form class="form" @onsubmit="SubmitAsync">
        <label>
            <span class="section-label">Username</span>
            <input @bind="request.Username" @bind:event="oninput" autocomplete="username" autocapitalize="off" />
        </label>
        <label>
            <span class="section-label">Password</span>
            <input type="password" @bind="request.Password" @bind:event="oninput" autocomplete="current-password" />
        </label>
        <button type="submit" class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(request.Username) || string.IsNullOrEmpty(request.Password))">
            @(busy ? "Logging in..." : "Log in")
        </button>
    </form>

    <p class="muted small">No account yet? <a href="@($"register{ReturnQuery}")">Create one</a></p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private readonly LoginRequest request = new();
    private bool busy;
    private UiError? error;

    private string ReturnQuery => string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;

        var response = await AccountService.LoginAsync(request);

        busy = false;
        if (response.Succeeded)
            Navigation.NavigateTo(SafeReturnUrl(ReturnUrl));
        else
            error = UiError.From(response);
    }

    // Only allow local paths, so the login page can't be used to redirect elsewhere. returnUrl is app-relative
    // ("/play/123"); the leading slash is dropped so NavigateTo resolves it against the base href. Otherwise
    // "/play/123" would go to the domain root (jochemkok.nl/play/123) when the app is served under /guessthelyrics/.
    public static string SafeReturnUrl(string? returnUrl) =>
        !string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith('/') && !returnUrl.StartsWith("//") && !returnUrl.Contains('\\')
            ? returnUrl.TrimStart('/')
            : string.Empty;
}
