# Copy to /opt/guessthelyrics/.env (chmod 600) and fill in. Never commit the real .env.

# Set by update.sh. Empty means "latest" until the first update has run.
APP_VERSION=

# SQL Server sa password: at least 8 characters with upper case, lower case, digits and symbols.
DB_PASSWORD=

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY=

# Where players open the site, and the path the UI is served under.
PUBLIC_ORIGIN=https://jochemkok.nl
BASE_PATH=/guessthelyrics/

# Host ports (bound to 127.0.0.1 only). Check they are free first: sudo ss -ltnp
API_PORT=5090
UI_PORT=5091
